---
import type { ActivitySnapshot } from "@/data/activity";
interface Props {
  snapshot: ActivitySnapshot;
  id: string;
}
const { snapshot, id } = Astro.props;
const leading = new Date(snapshot.start).getUTCDay();
const weeks = Math.ceil((leading + snapshot.days.length) / 7);
const cells = [
  ...Array.from({ length: leading }, () => null),
  ...snapshot.days,
];
const total = snapshot.days.reduce((sum, day) => sum + day.count, 0);
const active = snapshot.days.filter((day) => day.count > 0).length;
const maximum = Math.max(...snapshot.days.map((day) => day.count), 1);
const level = (count: number) =>
  count === 0 ? 0 : Math.max(1, Math.ceil((count / maximum) * 4));
const months = snapshot.days
  .flatMap((day, index) =>
    day.date.endsWith("-01") || index === 0
      ? [
          {
            name: new Date(day.date).toLocaleDateString("en", {
              month: "short",
              timeZone: "UTC",
            }),
            column: Math.floor((leading + index) / 7) + 1,
          },
        ]
      : [],
  )
  .filter(
    (month, index, list) =>
      index === list.length - 1 || list[index + 1]!.column - month.column >= 3,
  );
const numbers = new Intl.NumberFormat("en-US");
---

<section class="activity-calendar" aria-labelledby={`${id}-activity-title`}>
  <h4 id={`${id}-activity-title`}>Daily {snapshot.metric}</h4>
  <p class="activity-calendar__summary">
    <strong>{numbers.format(total)}</strong>{" "}
    {snapshot.metric} · {active} active days
  </p>
  <div
    class="activity-calendar__scroll"
    tabindex="0"
    role="img"
    aria-label={`Daily ${snapshot.metric} from ${snapshot.start} to ${snapshot.end}. ${numbers.format(total)} total. Exact dates and counts are available in Daily values below.`}
  >
    <div
      class="activity-calendar__chart"
      style={`--weeks:${weeks}`}
      aria-hidden="true"
    >
      <div class="activity-calendar__months">
        {
          months.map((month) => (
            <span style={`grid-column:${month.column} / span 3`}>
              {month.name}
            </span>
          ))
        }
      </div>
      <div class="activity-calendar__grid">
        {
          cells.map((day) => (
            <span
              class:list={[
                "activity-calendar__day",
                { "activity-calendar__day--padding": !day },
              ]}
              data-level={day ? level(day.count) : 0}
              title={
                day ? `${day.date}: ${day.count} ${snapshot.metric}` : undefined
              }
            />
          ))
        }
      </div>
    </div>
  </div>
  <div class="activity-calendar__legend" aria-hidden="true">
    <span>Less</span>{[0, 1, 2, 3, 4].map((n) => <i data-level={n} />)}<span
      >More</span
    >
  </div>
  <p class="activity-calendar__scope">
    {
      snapshot.metric === "submissions"
        ? "Submission attempts, not unique solved problems."
        : "GitHub’s contribution calendar; its scope differs from the 30-day repository commit count."
    }
  </p>
  <p class="account-card__date">
    <time datetime={snapshot.start}>{snapshot.start}</time>–<time
      datetime={snapshot.end}>{snapshot.end}</time
    > · 365 days. Last day may be partial. Snapshot <time
      datetime={snapshot.observedAt}>{snapshot.observedAt.slice(0, 10)}</time
    > (UTC).
  </p>
  <details class="activity-calendar__values">
    <summary>Daily values</summary>
    <div
      class="activity-calendar__table-wrap"
      tabindex="0"
      role="region"
      aria-label={`Daily ${snapshot.metric} values`}
    >
      <table>
        <caption>Daily {snapshot.metric}, newest first</caption><thead
          ><tr
            ><th scope="col">Date (UTC)</th><th scope="col"
              >{
                snapshot.metric === "contributions"
                  ? "Contributions"
                  : "Submissions"
              }</th
            ></tr
          ></thead
        ><tbody
          >{
            [...snapshot.days].reverse().map((day) => (
              <tr>
                <>
                  <th scope="row">
                    <time datetime={day.date}>{day.date}</time>
                  </th>
                  <td>{numbers.format(day.count)}</td>
                </>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
  </details>
</section>
