---
interface Props {
  name:
    | "arrow"
    | "sun"
    | "moon"
    | "external"
    | "copy"
    | "check"
    | "print"
    | "download"
    | "github";
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "arrow" && (
      <>
        <>
          <path d="M5 12h14" />
          <path d="m14 7 5 5-5 5" />
        </>
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <>
          <circle cx="12" cy="12" r="3.6" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
        </>
      </>
    )
  }
  {
    name === "moon" && (
      <path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z" />
    )
  }
  {
    name === "external" && (
      <>
        <>
          <path d="M14 5h5v5" />
          <path d="M10 14 19 5" />
          <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
        </>
      </>
    )
  }
  {
    name === "copy" && (
      <>
        <>
          <rect x="8" y="8" width="11" height="11" rx="2" />
          <path d="M16 8V6a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h2" />
        </>
      </>
    )
  }
  {name === "check" && <path d="m5 12 4 4L19 6" />}
  {
    name === "print" && (
      <>
        <>
          <path d="M6 9V3h12v6" />
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
          <path d="M6 14h12v7H6z" />
        </>
      </>
    )
  }
  {
    name === "download" && (
      <>
        <>
          <path d="M12 3v12" />
          <path d="m7 10 5 5 5-5" />
          <path d="M5 21h14" />
        </>
      </>
    )
  }
  {
    name === "github" && (
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-6 0C5.8.1 4.7.5 4.7.5A5 5 0 0 0 4.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 9 18v4" />
    )
  }
</svg>
