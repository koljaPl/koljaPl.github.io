---
import { getCollection } from "astro:content";
import ContentNeeded from "@/components/ContentNeeded.astro";
import Icon from "@/components/Icon.astro";
import {
  experience,
  profile,
  skills,
  socialLinks,
  resumeSettings,
} from "@/data/site";
import { pagePublication } from "@/data/publication";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const contactLinks = socialLinks.filter(
  (link) => link.kind !== "email" && link.href,
);
---

<BaseLayout
  title="Résumé"
  description="A printable résumé for Nicklas Plugin."
  noindex={resumeSettings.draft || !pagePublication.resume}
>
  <div
    class:list={[
      "resume-page section-shell",
      { "resume-page--draft": resumeSettings.draft },
    ]}
  >
    <div class="container">
      {
        !resumeSettings.draft && (
          <div class="resume-toolbar" aria-label="Résumé actions">
            <p>HTML résumé · Print-ready</p>
            <div>
              <button
                class="button button--secondary"
                type="button"
                data-print-resume
              >
                <Icon name="print" size={17} /> Print
              </button>
              {profile.resumePdfUrl.value ? (
                <a
                  class="button button--primary"
                  href={profile.resumePdfUrl.value}
                  download
                >
                  <Icon name="download" size={17} /> Download PDF
                </a>
              ) : (
                <span class="resume-pdf-status">PDF not supplied</span>
              )}
            </div>
          </div>
        )
      }
      {
        resumeSettings.draft && (
          <section class="resume-draft-notice" aria-labelledby="draft-title">
            <>
              <p class="technical-label">Work in progress</p>
              <h1 id="draft-title">Résumé in progress.</h1>
              <p>
                I’m putting the details together. The finished résumé and PDF
                will be available here.
              </p>
              <h2>To-Do</h2>
              <ul>
                {resumeSettings.todo.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="text-link" href="/contact/">
                Get in touch <span aria-hidden="true">↗</span>
              </a>
            </>
          </section>
        )
      }
      <article
        class="resume-sheet"
        inert={resumeSettings.draft}
        aria-hidden={resumeSettings.draft ? "true" : undefined}
      >
        <header class="resume-header">
          <div>
            <p class="technical-label">Résumé</p>
            {
              resumeSettings.draft ? (
                <h2>{profile.name}</h2>
              ) : (
                <h1>{profile.name}</h1>
              )
            }
            <p>{profile.areas.join(" · ")}</p>
          </div>
          {
            (profile.email.value ||
              profile.location.value ||
              contactLinks.length > 0) && (
              <address>
                {profile.email.value && (
                  <a href={`mailto:${profile.email.value}`}>
                    {profile.email.value}
                  </a>
                )}
                {profile.location.value && (
                  <span>{profile.location.value}</span>
                )}
                {contactLinks.map((link) => (
                  <a href={link.href!}>{link.label}</a>
                ))}
              </address>
            )
          }
        </header>

        <section
          class="resume-section"
          aria-labelledby="resume-profile-heading"
        >
          <h2 id="resume-profile-heading">Profile</h2>
          {
            profile.biography.value ? (
              <p>{profile.biography.value}</p>
            ) : (
              <ContentNeeded compact title={profile.biography.placeholder} />
            )
          }
        </section>

        <section
          class="resume-section"
          aria-labelledby="resume-experience-heading"
        >
          <h2 id="resume-experience-heading">Experience</h2>
          {
            experience.length > 0 ? (
              <ol class="resume-entry-list">
                {experience.map((entry) => (
                  <li>
                    <div>
                      <h3>{entry.role}</h3>
                      <p>{entry.organization}</p>
                    </div>
                    <p class="resume-entry-list__date">
                      {entry.startDate} — {entry.endDate ?? "Present"}
                    </p>
                    <p>{entry.summary}</p>
                  </li>
                ))}
              </ol>
            ) : (
              <ContentNeeded
                compact
                title="Roles, organizations, dates, and verified highlights have not yet been supplied."
              />
            )
          }
        </section>

        <section
          class="resume-section"
          aria-labelledby="resume-projects-heading"
        >
          <h2 id="resume-projects-heading">Selected projects</h2>
          <ol class="resume-project-list">
            {
              projects.map((project) => (
                <li>
                  <h3>{project.data.name}</h3>
                  <p>
                    {project.data.shortDescription ??
                      "Description and technical details to be supplied."}
                  </p>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="resume-section" aria-labelledby="resume-skills-heading">
          <h2 id="resume-skills-heading">Skills</h2>
          {
            skills.length > 0 ? (
              <dl class="resume-skills">
                {skills.map((group) => (
                  <div>
                    <dt>{group.title}</dt>
                    <dd>{group.skills.join(", ")}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <ContentNeeded
                compact
                title="Skills and supporting evidence have not yet been supplied."
              />
            )
          }
        </section>
      </article>
    </div>
  </div>

  <script>
    document
      .querySelector("[data-print-resume]")
      ?.addEventListener("click", () => window.print());
  </script>
</BaseLayout>
